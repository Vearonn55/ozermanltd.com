// ============================================================
// CORPORATE WEBSITE DATABASE SCHEMA
// Generated for: Dovec / Basman / Oero-style group websites
// DBML v2 — compatible with dbdiagram.io & dbdocs.io
// ============================================================


// ============================================================
// GROUP 1 — USERS & AUTHENTICATION
// ============================================================

Table users {
  id              int           [pk, increment]
  name            varchar(120)  [not null]
  email           varchar(180)  [not null, unique]
  password_hash   varchar(255)  [not null]
  role            varchar(30)   [not null, default: 'editor', note: 'super_admin | content_manager | editor']
  status          varchar(20)   [not null, default: 'active', note: 'active | inactive | suspended']
  avatar          varchar(255)  [null]
  reset_token     varchar(100)  [null]
  reset_expires   timestamp     [null]
  last_login_at   timestamp     [null]
  created_at      timestamp     [not null, default: `now()`]
  updated_at      timestamp     [not null, default: `now()`]
}

Table user_sessions {
  id             int          [pk, increment]
  user_id        int          [not null, ref: > users.id]
  session_token  varchar(255) [not null, unique]
  ip_address     varchar(45)  [null]
  user_agent     text         [null]
  expires_at     timestamp    [not null]
  created_at     timestamp    [not null, default: `now()`]
}

Table user_activity_log {
  id           int          [pk, increment]
  user_id      int          [not null, ref: > users.id]
  action       varchar(80)  [not null, note: 'e.g. create, update, delete, login']
  entity_type  varchar(80)  [null,     note: 'e.g. news, project, media']
  entity_id    int          [null]
  payload      json         [null]
  ip_address   varchar(45)  [null]
  created_at   timestamp    [not null, default: `now()`]
}


// ============================================================
// GROUP 2 — LANGUAGES
// ============================================================

Table languages {
  id          int          [pk, increment]
  code        varchar(5)   [not null, unique, note: 'en | tr | ar']
  name        varchar(60)  [not null]
  flag_icon   varchar(100) [null]
  is_default  boolean      [not null, default: false]
  is_active   boolean      [not null, default: true]
  sort_order  int          [not null, default: 0]
}


// ============================================================
// GROUP 3 — PAGES & CONTENT
// ============================================================

Table pages {
  id             int          [pk, increment]
  slug           varchar(160) [not null, unique, note: 'language-agnostic key, e.g. about-us']
  template       varchar(80)  [not null, default: 'default', note: 'default | home | contact | sector | project']
  status         varchar(20)  [not null, default: 'draft', note: 'published | draft | archived']
  show_in_nav    boolean      [not null, default: true]
  sort_order     int          [not null, default: 0]
  parent_id      int          [null, ref: > pages.id]
  published_at   timestamp    [null]
  created_at     timestamp    [not null, default: `now()`]
  updated_at     timestamp    [not null, default: `now()`]
}

Table page_translations {
  id                int           [pk, increment]
  page_id           int           [not null, ref: > pages.id]
  language_id       int           [not null, ref: > languages.id]
  title             varchar(255)  [not null]
  content           longtext      [null]
  excerpt           text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (page_id, language_id) [unique]
  }
}

Table hero_slides {
  id          int          [pk, increment]
  page_id     int          [not null, ref: > pages.id]
  language_id int          [not null, ref: > languages.id]
  media_id    int          [null,     ref: > media.id]
  title       varchar(255) [null]
  subtitle    varchar(255) [null]
  cta_text    varchar(80)  [null]
  cta_url     varchar(255) [null]
  sort_order  int          [not null, default: 0]
  is_active   boolean      [not null, default: true]
}

Table stat_counters {
  id          int          [pk, increment]
  page_id     int          [not null, ref: > pages.id]
  language_id int          [not null, ref: > languages.id]
  label       varchar(120) [not null]
  value       varchar(60)  [not null, note: 'e.g. 36+ or 4,000+']
  suffix      varchar(40)  [null,     note: 'e.g. Years or Homes Delivered']
  icon        varchar(80)  [null]
  sort_order  int          [not null, default: 0]
}


// ============================================================
// GROUP 4 — MENUS
// ============================================================

Table menus {
  id        int         [pk, increment]
  location  varchar(60) [not null, unique, note: 'header | footer_col1 | footer_col2 | footer_col3']
  is_active boolean     [not null, default: true]
}

Table menu_items {
  id         int          [pk, increment]
  menu_id    int          [not null, ref: > menus.id]
  parent_id  int          [null,     ref: > menu_items.id]
  url        varchar(255) [null]
  target     varchar(10)  [not null, default: '_self']
  icon       varchar(80)  [null]
  sort_order int          [not null, default: 0]
  is_active  boolean      [not null, default: true]
}

Table menu_item_translations {
  id       int          [pk, increment]
  item_id  int          [not null, ref: > menu_items.id]
  language_id int       [not null, ref: > languages.id]
  label    varchar(120) [not null]

  indexes {
    (item_id, language_id) [unique]
  }
}


// ============================================================
// GROUP 5 — MEDIA
// ============================================================

Table media_folders {
  id         int          [pk, increment]
  parent_id  int          [null, ref: > media_folders.id]
  name       varchar(120) [not null]
  path       varchar(500) [not null]
  created_at timestamp    [not null, default: `now()`]
}

Table media {
  id              int           [pk, increment]
  folder_id       int           [null, ref: > media_folders.id]
  uploaded_by     int           [null, ref: > users.id]
  file_name       varchar(255)  [not null, note: 'stored filename on disk']
  original_name   varchar(255)  [not null, note: 'original upload name']
  file_path       varchar(500)  [not null]
  webp_path       varchar(500)  [null]
  avif_path       varchar(500)  [null]
  thumbnail_path  varchar(500)  [null]
  file_type       varchar(20)   [not null, note: 'image | video | document | other']
  mime_type       varchar(100)  [null]
  file_size       int           [null, note: 'bytes']
  width           int           [null]
  height          int           [null]
  duration_sec    int           [null, note: 'for video']
  alt_text        varchar(255)  [null]
  caption         text          [null]
  is_active       boolean       [not null, default: true]
  created_at      timestamp     [not null, default: `now()`]
}


// ============================================================
// GROUP 6 — BUSINESS STRUCTURE
// (Sectors → Subsidiaries → Brands)
// ============================================================

Table sectors {
  id         int         [pk, increment]
  icon       varchar(80) [null]
  color      varchar(20) [null, note: 'hex color for UI badge']
  sort_order int         [not null, default: 0]
  is_active  boolean     [not null, default: true]
  created_at timestamp   [not null, default: `now()`]
}

Table sector_translations {
  id                int           [pk, increment]
  sector_id         int           [not null, ref: > sectors.id]
  language_id       int           [not null, ref: > languages.id]
  name              varchar(120)  [not null]
  slug              varchar(160)  [not null]
  overview          text          [null]
  services_text     text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (sector_id, language_id) [unique]
    slug [unique]
  }
}

Table subsidiaries {
  id              int          [pk, increment]
  sector_id       int          [null,     ref: > sectors.id]
  logo            varchar(255) [null]
  website_url     varchar(255) [null]
  sort_order      int          [not null, default: 0]
  is_active       boolean      [not null, default: true]
  founded_at      date         [null]
  created_at      timestamp    [not null, default: `now()`]
}

Table subsidiary_translations {
  id                int           [pk, increment]
  subsidiary_id     int           [not null, ref: > subsidiaries.id]
  language_id       int           [not null, ref: > languages.id]
  name              varchar(120)  [not null]
  slug              varchar(160)  [not null]
  description       text          [null]
  services          text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (subsidiary_id, language_id) [unique]
    slug [unique]
  }
}

Table brands {
  id             int          [pk, increment]
  subsidiary_id  int          [not null, ref: > subsidiaries.id]
  logo           varchar(255) [null]
  website_url    varchar(255) [null]
  sort_order     int          [not null, default: 0]
  is_active      boolean      [not null, default: true]
}

Table brand_translations {
  id           int           [pk, increment]
  brand_id     int           [not null, ref: > brands.id]
  language_id  int           [not null, ref: > languages.id]
  name         varchar(120)  [not null]
  description  text          [null]

  indexes {
    (brand_id, language_id) [unique]
  }
}

Table team_members {
  id             int          [pk, increment]
  subsidiary_id  int          [null,     ref: > subsidiaries.id]
  media_id       int          [null,     ref: > media.id]
  email          varchar(180) [null]
  phone          varchar(40)  [null]
  type           varchar(30)  [not null, note: 'founder | board | management | staff']
  sort_order     int          [not null, default: 0]
  is_active      boolean      [not null, default: true]
  created_at     timestamp    [not null, default: `now()`]
}

Table team_member_translations {
  id           int           [pk, increment]
  member_id    int           [not null, ref: > team_members.id]
  language_id  int           [not null, ref: > languages.id]
  full_name    varchar(120)  [not null]
  position     varchar(120)  [null]
  bio          text          [null]

  indexes {
    (member_id, language_id) [unique]
  }
}

Table awards {
  id             int          [pk, increment]
  subsidiary_id  int          [null, ref: > subsidiaries.id]
  media_id       int          [null, ref: > media.id]
  year           smallint     [not null]
  organizer      varchar(120) [null]
  sort_order     int          [not null, default: 0]
  created_at     timestamp    [not null, default: `now()`]
}

Table award_translations {
  id           int           [pk, increment]
  award_id     int           [not null, ref: > awards.id]
  language_id  int           [not null, ref: > languages.id]
  title        varchar(200)  [not null]
  category     varchar(120)  [null]
  description  text          [null]

  indexes {
    (award_id, language_id) [unique]
  }
}


// ============================================================
// GROUP 7 — PROJECTS
// ============================================================

Table project_categories {
  id         int         [pk, increment]
  icon       varchar(80) [null]
  sort_order int         [not null, default: 0]
  is_active  boolean     [not null, default: true]
}

Table project_category_translations {
  id           int          [pk, increment]
  category_id  int          [not null, ref: > project_categories.id]
  language_id  int          [not null, ref: > languages.id]
  name         varchar(120) [not null]
  slug         varchar(160) [not null]

  indexes {
    (category_id, language_id) [unique]
  }
}

Table projects {
  id                int             [pk, increment]
  category_id       int             [null,     ref: > project_categories.id]
  subsidiary_id     int             [null,     ref: > subsidiaries.id]
  featured_image_id int             [null,     ref: > media.id]
  status            varchar(20)     [not null, default: 'planning', note: 'planning | ongoing | completed | cancelled']
  location          varchar(255)    [null]
  latitude          decimal(10,7)   [null]
  longitude         decimal(10,7)   [null]
  total_units       int             [null]
  delivery_date     varchar(40)     [null, note: 'stored as string, e.g. June 2027']
  start_price       decimal(15,2)   [null]
  currency          varchar(5)      [null, default: 'GBP']
  is_featured       boolean         [not null, default: false]
  is_active         boolean         [not null, default: true]
  created_at        timestamp       [not null, default: `now()`]
  updated_at        timestamp       [not null, default: `now()`]
}

Table project_translations {
  id                int           [pk, increment]
  project_id        int           [not null, ref: > projects.id]
  language_id       int           [not null, ref: > languages.id]
  title             varchar(255)  [not null]
  slug              varchar(280)  [not null]
  description       longtext      [null]
  features          text          [null]
  payment_plan      text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (project_id, language_id) [unique]
    slug [unique]
  }
}

Table project_galleries {
  id          int          [pk, increment]
  project_id  int          [not null, ref: > projects.id]
  media_id    int          [not null, ref: > media.id]
  caption     varchar(255) [null]
  type        varchar(20)  [not null, default: 'exterior', note: 'exterior | interior | floorplan | 360']
  sort_order  int          [not null, default: 0]
}

Table project_virtual_tours {
  id             int          [pk, increment]
  project_id     int          [not null, ref: > projects.id]
  tour_url       varchar(500) [not null]
  thumbnail_url  varchar(500) [null]
  label          varchar(120) [null]
  vr_compatible  boolean      [not null, default: false]
  sort_order     int          [not null, default: 0]
}

Table project_unit_types {
  id               int             [pk, increment]
  project_id       int             [not null, ref: > projects.id]
  label            varchar(80)     [not null, note: 'e.g. Studio, 1+1, 2+1, Villa']
  bedrooms         smallint        [null]
  size_sqm         decimal(8,2)    [null]
  price_from       decimal(15,2)   [null]
  currency         varchar(5)      [null, default: 'GBP']
  available_units  int             [null]
  total_units      int             [null]
}


// ============================================================
// GROUP 8 — NEWS & BLOG
// ============================================================

Table news_categories {
  id         int         [pk, increment]
  color      varchar(20) [null]
  icon       varchar(80) [null]
  sort_order int         [not null, default: 0]
  is_active  boolean     [not null, default: true]
}

Table news_category_translations {
  id           int          [pk, increment]
  category_id  int          [not null, ref: > news_categories.id]
  language_id  int          [not null, ref: > languages.id]
  name         varchar(120) [not null]
  slug         varchar(160) [not null]

  indexes {
    (category_id, language_id) [unique]
  }
}

Table news_tags {
  id int [pk, increment]
}

Table news_tag_translations {
  id           int          [pk, increment]
  tag_id       int          [not null, ref: > news_tags.id]
  language_id  int          [not null, ref: > languages.id]
  name         varchar(80)  [not null]
  slug         varchar(100) [not null]

  indexes {
    (tag_id, language_id) [unique]
  }
}

Table news {
  id                int       [pk, increment]
  category_id       int       [null,     ref: > news_categories.id]
  subsidiary_id     int       [null,     ref: > subsidiaries.id]
  featured_image_id int       [null,     ref: > media.id]
  author_id         int       [null,     ref: > users.id]
  status            varchar(20) [not null, default: 'draft', note: 'published | draft | scheduled | archived']
  publish_date      timestamp [null]
  is_featured       boolean   [not null, default: false]
  is_pinned         boolean   [not null, default: false]
  view_count        int       [not null, default: 0]
  created_at        timestamp [not null, default: `now()`]
  updated_at        timestamp [not null, default: `now()`]
}

Table news_translations {
  id                int           [pk, increment]
  news_id           int           [not null, ref: > news.id]
  language_id       int           [not null, ref: > languages.id]
  title             varchar(255)  [not null]
  slug              varchar(280)  [not null]
  content           longtext      [null]
  excerpt           text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (news_id, language_id) [unique]
    slug [unique]
  }
}

Table news_tag_pivot {
  news_id  int [not null, ref: > news.id]
  tag_id   int [not null, ref: > news_tags.id]

  indexes {
    (news_id, tag_id) [pk]
  }
}

Table news_comments {
  id           int          [pk, increment]
  news_id      int          [not null, ref: > news.id]
  author_name  varchar(100) [not null]
  author_email varchar(180) [not null]
  content      text         [not null]
  status       varchar(20)  [not null, default: 'pending', note: 'pending | approved | rejected']
  created_at   timestamp    [not null, default: `now()`]
}


// ============================================================
// GROUP 9 — GALLERY COLLECTIONS
// ============================================================

Table gallery_collections {
  id              int       [pk, increment]
  subsidiary_id   int       [null, ref: > subsidiaries.id]
  cover_image_id  int       [null, ref: > media.id]
  sort_order      int       [not null, default: 0]
  is_active       boolean   [not null, default: true]
  created_at      timestamp [not null, default: `now()`]
}

Table gallery_collection_translations {
  id            int           [pk, increment]
  collection_id int           [not null, ref: > gallery_collections.id]
  language_id   int           [not null, ref: > languages.id]
  title         varchar(200)  [not null]
  slug          varchar(240)  [not null]
  description   text          [null]

  indexes {
    (collection_id, language_id) [unique]
  }
}

Table gallery_items {
  id             int          [pk, increment]
  collection_id  int          [not null, ref: > gallery_collections.id]
  media_id       int          [not null, ref: > media.id]
  sort_order     int          [not null, default: 0]
  caption        varchar(255) [null]
}


// ============================================================
// GROUP 10 — OFFICES & CONTACT
// ============================================================

Table offices {
  id               int           [pk, increment]
  subsidiary_id    int           [null,     ref: > subsidiaries.id]
  phone            varchar(30)   [null]
  email            varchar(180)  [null]
  whatsapp         varchar(30)   [null]
  latitude         decimal(10,7) [null]
  longitude        decimal(10,7) [null]
  is_headquarters  boolean       [not null, default: false]
  is_active        boolean       [not null, default: true]
}

Table office_translations {
  id            int           [pk, increment]
  office_id     int           [not null, ref: > offices.id]
  language_id   int           [not null, ref: > languages.id]
  label         varchar(120)  [null, note: 'e.g. Head Office, Sales Office']
  address       text          [null]
  city          varchar(80)   [null]
  country       varchar(80)   [null]
  working_hours varchar(255)  [null]

  indexes {
    (office_id, language_id) [unique]
  }
}

Table contact_messages {
  id            int          [pk, increment]
  office_id     int          [null, ref: > offices.id]
  project_id    int          [null, ref: > projects.id]
  name          varchar(120) [not null]
  email         varchar(180) [not null]
  phone         varchar(40)  [null]
  country       varchar(80)  [null]
  subject       varchar(255) [null]
  message       text         [not null]
  status        varchar(20)  [not null, default: 'new', note: 'new | read | replied | archived']
  ip_address    varchar(45)  [null]
  utm_source    varchar(100) [null]
  utm_medium    varchar(100) [null]
  utm_campaign  varchar(100) [null]
  read_at       timestamp    [null]
  replied_at    timestamp    [null]
  created_at    timestamp    [not null, default: `now()`]
}


// ============================================================
// GROUP 11 — CAREERS
// ============================================================

Table job_departments {
  id             int       [pk, increment]
  subsidiary_id  int       [null, ref: > subsidiaries.id]
  sort_order     int       [not null, default: 0]
  created_at     timestamp [not null, default: `now()`]
}

Table job_department_translations {
  id            int          [pk, increment]
  department_id int          [not null, ref: > job_departments.id]
  language_id   int          [not null, ref: > languages.id]
  name          varchar(120) [not null]

  indexes {
    (department_id, language_id) [unique]
  }
}

Table job_listings {
  id             int          [pk, increment]
  department_id  int          [null, ref: > job_departments.id]
  subsidiary_id  int          [null, ref: > subsidiaries.id]
  type           varchar(20)  [not null, default: 'full_time', note: 'full_time | part_time | contract | internship']
  location       varchar(120) [null]
  status         varchar(20)  [not null, default: 'open', note: 'open | closed | paused']
  expires_at     timestamp    [null]
  created_at     timestamp    [not null, default: `now()`]
  updated_at     timestamp    [not null, default: `now()`]
}

Table job_listing_translations {
  id                int           [pk, increment]
  job_id            int           [not null, ref: > job_listings.id]
  language_id       int           [not null, ref: > languages.id]
  title             varchar(200)  [not null]
  slug              varchar(240)  [not null]
  description       longtext      [null]
  requirements      text          [null]
  benefits          text          [null]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]

  indexes {
    (job_id, language_id) [unique]
    slug [unique]
  }
}

Table job_applications {
  id                  int          [pk, increment]
  job_id              int          [not null, ref: > job_listings.id]
  full_name           varchar(120) [not null]
  email               varchar(180) [not null]
  phone               varchar(40)  [null]
  linkedin_url        varchar(255) [null]
  resume_path         varchar(500) [null]
  cover_letter_path   varchar(500) [null]
  cover_letter_text   text         [null]
  status              varchar(20)  [not null, default: 'received', note: 'received | reviewing | shortlisted | rejected | hired']
  notes               text         [null, note: 'internal HR notes']
  created_at          timestamp    [not null, default: `now()`]
}


// ============================================================
// GROUP 12 — SEO
// ============================================================

Table seo_meta {
  id                int           [pk, increment]
  entity_type       varchar(60)   [not null, note: 'page | news | project | sector | subsidiary | job']
  entity_id         int           [not null]
  language_id       int           [not null, ref: > languages.id]
  meta_title        varchar(160)  [null]
  meta_description  varchar(320)  [null]
  og_title          varchar(160)  [null]
  og_description    varchar(320)  [null]
  og_image_id       int           [null, ref: > media.id]
  canonical_url     varchar(500)  [null]
  robots            varchar(80)   [null, default: 'index, follow']
  structured_data   json          [null, note: 'JSON-LD schema markup']
  updated_at        timestamp     [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, language_id) [unique]
  }
}

Table redirects {
  id          int          [pk, increment]
  from_path   varchar(500) [not null, unique]
  to_path     varchar(500) [not null]
  type        varchar(5)   [not null, default: '301', note: '301 | 302']
  is_active   boolean      [not null, default: true]
  hit_count   int          [not null, default: 0]
  created_at  timestamp    [not null, default: `now()`]
}

Table sitemaps {
  id          int             [pk, increment]
  url         varchar(500)    [not null, unique]
  changefreq  varchar(20)     [null, default: 'weekly', note: 'always|hourly|daily|weekly|monthly|yearly|never']
  priority    decimal(2,1)    [null, default: 0.5]
  lastmod     timestamp       [null]
  is_active   boolean         [not null, default: true]
}


// ============================================================
// GROUP 13 — SETTINGS
// ============================================================

Table settings {
  id          int          [pk, increment]
  group       varchar(60)  [not null, note: 'general | social | smtp | analytics | maintenance']
  key         varchar(120) [not null]
  value       text         [null]
  type        varchar(20)  [not null, default: 'text', note: 'text | json | boolean | integer']
  label       varchar(200) [null, note: 'human-readable name for admin UI']
  updated_at  timestamp    [not null, default: `now()`]
  updated_by  int          [null, ref: > users.id]

  indexes {
    (group, key) [unique]
  }
}
