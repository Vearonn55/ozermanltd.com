DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ozermanltd
DB_USERNAME=root
DB_PASSWORD=
# Use DB_PASSWORD=root when running MySQL via Docker (make db-docker-setup)
DB_USE_DUMMY_DATA=false
# Production cPanel: set DB_FALLBACK_DUMMY=false so the public site never serves DummyData
DB_FALLBACK_DUMMY=true

# --- cPanel production (edit /home/USER/.env on the server) ---
# Use EXACT names from cPanel → MySQL Databases (prefix = cPanel username).
# Example for account ozermanl:
# DB_HOST=localhost
# DB_DATABASE=ozermanl_MAIN
# DB_USERNAME=ozermanl_SYSADMIN
# DB_PASSWORD=your-mysql-password
# DB_USE_DUMMY_DATA=false
# DB_FALLBACK_DUMMY=false
# See docs/CPANEL-DATABASE.md

APP_URL=https://ozermanltd.com
APP_ENV=development

# Soft launch: public site shows Under Construction except /qr and /catalogues
SITE_UNDER_CONSTRUCTION=true
# Keep false until Cloudflare orange-cloud is ready
CLOUDFLARE_ENFORCE=false

LEGACY_SITE_URL=http://localhost:8080
PLAUSIBLE_DOMAIN=ozermanltd.com
ANALYTICS_REQUIRE_CONSENT=true
PRIVACY_POLICY_VERSION=1.0
ANALYTICS_RETENTION_DAYS=365
APP_KEY=change-this-secret-key

# External backend sync (leave disabled until your API exists)
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_API_URL=
EXTERNAL_API_INGEST_PATH=/api/ingest
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT=10

# cPanel: docs/CPANEL-DATABASE.md and docs/PRODUCTION-LAUNCH.md
