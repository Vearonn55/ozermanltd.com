DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ozermanltd
DB_USERNAME=root
DB_PASSWORD=
# Use DB_PASSWORD=root when running MySQL via Docker (make db-docker-setup)
DB_USE_DUMMY_DATA=false
DB_FALLBACK_DUMMY=true

APP_URL=https://ozermanltd.com
APP_ENV=development

LEGACY_SITE_URL=http://localhost:8080
PLAUSIBLE_DOMAIN=ozermanltd.com
ANALYTICS_REQUIRE_CONSENT=true
PRIVACY_POLICY_VERSION=1.0
ANALYTICS_RETENTION_DAYS=365
APP_KEY=change-this-secret-key

# External backend sync (leave disabled until your API exists)
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_API_URL=
EXTERNAL_API_INGEST_PATH=/api/ingest
EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT=10
